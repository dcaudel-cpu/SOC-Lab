<!-- Local Wazuh Rules for Sysmon & Active Directory Detection -->
<!-- Sanitized backup for repository documentation -->

<group name="sysmon,">
  <!-- Base Rule: Sysmon Event ID 1 (Process Creation) -->
  <rule id="100100" level="3">
    <if_sid>61603</if_sid>
    <description>Sysmon - Process Creation: $(win.eventdata.image)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Tuning: Suppress routine Windows background executables -->
  <rule id="100101" level="0">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)C:\\Windows\\System32\\(svchost|taskhostw|conhost|backgroundTaskHost)\.exe$</field>
    <description>Sysmon - Suppress routine Windows background processes</description>
  </rule>

  <!-- Tuning: Suppress Windows Defender signature updates -->
  <rule id="100102" level="0">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\.*\\MpCmdRun\.exe$</field>
    <description>Sysmon - Suppress Windows Defender update utility</description>
  </rule>

  <!-- Detection: Encoded PowerShell Execution (MITRE T1059.001) -->
  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand)\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Sysmon - Suspicious Encoded PowerShell Command Executed on $(agent.name)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Detection: Remote Service Execution / PsExec (MITRE T1569.002) -->
  <rule id="100115" level="12">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\PSEXESVC\.exe$</field>
    <description>Sysmon - PsExec Service Binary Executed on $(agent.name)</description>
    <mitre>
      <id>T1569.002</id>
    </mitre>
  </rule>
</group>
